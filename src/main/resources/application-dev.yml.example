# 开发环境配置模板
# 注意：这是 example 文件，可以提交 GitHub
# 真实密码、真实 API Key 不要写进仓库

spring:
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://localhost:3306/ai_knowledge_assistant?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
    username: root
    password: your_mysql_password

  data:
    redis:
      host: localhost
      port: 6379
      password: ""
      database: 0

jwt:
  secret: your_jwt_secret_at_least_32_chars

doubao:
  api-key: your_doubao_api_key
  embedding-url: https://ark.cn-beijing.volces.com/api/v3/embeddings/multimodal
  embedding-model: doubao-embedding-vision-251215